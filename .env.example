# Copy this file to .env (next to main.py, or next to Umay.exe) and fill it in.
# Lines starting with # are comments. Values are single-line.

# --- Keys ---------------------------------------------------------------------
# OpenRouter key: only needed with UMAY_LLM=openrouter, or as the fallback for voice notes when
# local speech-to-text isn't set up (see Voice below). Spoken replies never use it.
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Tavily key for web search. https://app.tavily.com
TAVILY_API_KEY=

# Spotify Web API, for "play <song / artist / playlist>", queue, like, add to a playlist (planned.txt 23b).
# An app at https://developer.spotify.com/dashboard (owner needs Premium) with the redirect URI
# http://127.0.0.1:47822/callback and Web API ticked; its Client ID here (not the secret: none is needed).
# The first use opens Spotify's consent page once. Playback control works without it.
SPOTIFY_CLIENT_ID=

# --- You --------------------------------------------------------------------
# Your name as shown in the chat window (default: You).
UMAY_USER_NAME=

# --- Model ------------------------------------------------------------------
# Where Umay's replies come from: local = a model on this PC through Ollama (free, offline;
# install Ollama, then `ollama pull qwen3.5:4b`), openrouter = OPENROUTER_MODEL on OpenRouter.
# Her persona is personality.md.
UMAY_LLM=local
# The Ollama model the local one is made from, and its context window in tokens (her tool list
# alone is ~8,000). Umay makes UMAY_LOCAL_MODEL from them once (empty = umay-qwen3.5-4b).
UMAY_LOCAL_BASE_MODEL=qwen3.5:4b
UMAY_LOCAL_CONTEXT=16384
UMAY_LOCAL_MODEL=
# The OpenRouter model (empty = this default).
OPENROUTER_MODEL=google/gemini-3.7-flash
# The heavy model: plans multi-step requests and aims clicks on the screen (heavy_model.py).
# claude-code:<model>:<effort> runs Claude Code on your subscription (never paid per request);
# off = none (no plans, clicks use the local model's own point). Empty = claude-code:haiku:low.
UMAY_HEAVY_MODEL=
# At most this many heavy-model calls per request (empty = 20).
UMAY_HEAVY_MAX_CALLS=

# --- PC access --------------------------------------------------------------
# Folders Umay may read/change, separated by ; (default: Desktop;Downloads;Documents).
UMAY_ALLOWED_DIRS=

# --- Telegram (optional) -----------------------------------------------------
# Path to claude_comm.py, which owns the Telegram bot connection (see README).
CLAUDE_COMM_PATH=

# --- /c: hand tasks to Claude Code (optional) --------------------------------
# claude executable (default: `claude` on PATH, else the VS Code extension's copy).
CLAUDE_CODE_PATH=
# Folder Claude Code works in (default: Documents\Projects).
CLAUDE_CODE_CWD=
# More folders it may read and edit, separated by ; (default: Documents\Work).
CLAUDE_CODE_EXTRA_DIRS=

# --- Sleep mode ---------------------------------------------------------------
# Where sleep-mode jobs may work, separated by ; (default: Documents\Projects;Documents\Work).
UMAY_SLEEP_ROOTS=
# Where the "before" copies go (default: Documents\Failsafe).
UMAY_FAILSAFE_DIR=

# --- Health monitor -----------------------------------------------------------
# Warns you (popup + Telegram) when a value stays past its limit; without an answer for
# 10 minutes it ends the process using most of it. off = don't watch (sleep mode still
# turns it on while it works).
UMAY_HEALTH=on
# Limits (empty = these defaults). GPU temperature needs an NVIDIA GPU (nvidia-smi).
UMAY_HEALTH_GPU_TEMP=87
UMAY_HEALTH_RAM_PERCENT=92
UMAY_HEALTH_CPU_PERCENT=95
UMAY_HEALTH_DISK_FREE_PERCENT=5
# How long a value must stay past its limit before it counts (CPU load has its own).
UMAY_HEALTH_SUSTAIN_MINUTES=2
UMAY_HEALTH_CPU_MINUTES=5

# --- HUD ------------------------------------------------------------------------
# The orb with the clock and the panels (weather, vitals, storage, calendar) on the desktop.
# off = no HUD (the Ctrl+F1 panel can still bring it back for the session).
UMAY_HUD=on
# The light around the screen during a spoken conversation. Empty or off = none (the orb shows it).
UMAY_GLOW=
# Where the weather panel's weather is: a city ("Istanbul") or "lat,lon". Empty = this PC's IP's city.
UMAY_WEATHER_LOCATION=
# The news panel (Google News, free): the people, companies and countries followed, comma separated; after a |
# come other spellings it is also searched by, and -words that leave out articles with that word (empty = these).
# Once you tell Umay to follow or unfollow someone ("follow Nvidia in the news"), her own list
# (%LOCALAPPDATA%\Umay\news_watch.json) is used instead of this.
UMAY_NEWS_WATCH=Anthropic,Elon Musk,Sam Altman,OpenAI,Türkiye|Turkey|Erdogan|-Thanksgiving|-recipe|-recipes|-roast|-bingo,UK|Britain|British
# Its other headlines: Google News sections (TOP, WORLD, NATION, BUSINESS, TECHNOLOGY, SCIENCE, HEALTH,
# SPORTS, ENTERTAINMENT).
UMAY_NEWS_TOPICS=TECHNOLOGY,BUSINESS,WORLD,SCIENCE
# The news' language and country: en-US, tr-TR, de-DE...
UMAY_NEWS_REGION=en-US
# The markets panel (Yahoo Finance, free): its symbols as Yahoo writes them. .IS = Borsa Istanbul (about 15 min
# late), =X a currency pair, -USD a coin, =F a future (GC=F gold), ^ an index. Once you tell Umay to add or
# remove one ("add Apple to the markets"), her own list (%LOCALAPPDATA%\Umay\markets.json) is used instead.
UMAY_MARKET_SYMBOLS=XU100.IS,^GSPC,^IXIC,NVDA,TSLA,GOOGL,MSFT,USDTRY=X,GBPTRY=X,BTC-USD,GC=F
# The calendar's holidays (holiday_days.py): countries as the `holidays` package names them, and which part of
# the UK's bank holidays (ENG, SCT, WLS, NIR).
UMAY_HOLIDAYS=TR,GB
UMAY_HOLIDAYS_UK_PART=ENG

# --- Umay on her own (companion.py) ---------------------------------------------------------
# She greets you in the morning (once the camera sees you: "Umay, learn my face"), brings up important news,
# big market moves, rain coming, a low battery, a long stretch without a break. Aloud when the room is quiet,
# written in the text box when it's loud, another program uses the microphone or in the quiet hours; when
# you're away, urgent things (a ringing reminder, huge news) are a WhatsApp call. off = none of this.
UMAY_COMPANION=on
# No input this long: you're away.
UMAY_AWAY_MINUTES=5
# No voice (and no news calls) in these hours: start-end, e.g. 23-08.
UMAY_QUIET_HOURS=23-08
# The room's level (the wake listener's) above which she writes instead of speaking.
UMAY_NOISY_LEVEL=0.004
# Her model rates new headlines 1-10: told from this score, a call while you're away from the second.
UMAY_NEWS_SCORE=9
UMAY_NEWS_CALL_SCORE=10
# At the PC this long without a 5-minute break: she suggests one (0 = never).
UMAY_BREAK_MINUTES=120

# --- Claude Code in a terminal (claude_terminal.py) -------------------------------------------
# "Umay, open Claude Code and ..." opens it in Windows Terminal on the task. Its permission mode: auto (like
# sleep mode: it doesn't stop at every command), acceptEdits, or empty = Claude Code's own (asks each time).
UMAY_CLAUDE_PERMISSION_MODE=auto

# --- Voice (optional) --------------------------------------------------------
# Speech-to-text: local = Whisper on this PC (free; set it up once with
# `python setup_voice_env.py`), falling back to OpenRouter if it's missing or fails.
# openrouter = always Umay's model on OpenRouter.
UMAY_STT=local
# Local Whisper model (a faster-whisper name like large-v3-turbo, a Hugging Face id, or a
# model folder) and language (en, tr, ... or auto). Run setup_voice_env.py after changing
# the model: Umay never downloads one. Empty = large-v3-turbo, en.
UMAY_STT_MODEL=
UMAY_STT_LANGUAGE=
# Optional words to steer spelling (e.g. names), passed to Whisper as its prompt.
UMAY_STT_PROMPT=Umay
# Names Whisper keeps mishearing, put right after it hears them: wrong:right; wrong:right (whole words).
UMAY_STT_FIXES=
# Unload the model after this many minutes unused, freeing ~1.2 GB VRAM (0 = keep it loaded).
UMAY_STT_IDLE_MINUTES=10
# Where voice_env, the Whisper model and your voice clips live (default %LOCALAPPDATA%\Umay\voice).
UMAY_VOICE_HOME=
# Python of voice_env (empty = the one setup_voice_env.py made).
UMAY_STT_PYTHON=
# The venv voice_env borrows torch's CUDA libraries from; only setup_voice_env.py reads it
# (default Documents\Projects\Wichelberg_VoiceChanger\data\egitim\venv).
UMAY_TORCH_VENV=
# Keep confirmed voice clips (Telegram "Yes", âœ“/âœŽ under a ðŸŽ¤ transcript, voice_recorder.py)
# for training speech-to-text on your voice. off = keep nothing.
UMAY_VOICE_DATA=on
# Text-to-speech, only on this PC (free; reads sentence by sentence, then the voice pack makes it
# Umay's voice). When it can't run (its env missing, a game) the reply stays as text; speech is never
# sent to a paid service. off = no spoken replies. Unloaded after UMAY_TTS_IDLE_MINUTES (default 10).
UMAY_TTS=local
# piper (default) = English Piper on the CPU (`python setup_voice_env.py --piper`); chatterbox = the
# Turkish Chatterbox in tts_env, on the GPU only (stays quiet while the GPU is UMAY_TTS_GPU_BUSY
# percent busy, default 40, 0 = don't check).
UMAY_TTS_ENGINE=piper
# The Piper voice: a name in voice\tts_models\piper or an .onnx file (empty = en_US-lessac-medium).
UMAY_PIPER_VOICE=
UMAY_TTS_GPU_BUSY=
# Memory: finished conversations are judged important or unimportant by the local model; past
# UMAY_MEMORY_LIMIT_MB (empty = 100) the unimportant logs are deleted, then the important ones summarized
# (dates kept). off = keep chat_logs as they are.
UMAY_MEMORY=
UMAY_MEMORY_LIMIT_MB=
# Umay calls you on WhatsApp (calls.py): her own account is in WhatsApp Beta beside yours; your WhatsApp number
# with its country code. Beta's microphone must be VB-CABLE's "CABLE Output". Empty = no calls.
UMAY_CALL_NUMBER=
# During a game the voice models stop at once; the local model too only if the VRAM is still over
# this many MB without them (empty = 7000; 0 = always).
UMAY_GAME_VRAM_LIMIT_MB=
UMAY_TTS_IDLE_MINUTES=
# Chatterbox only: Turkish reference clip for its intonation (default voice\tts_models\reference_tr.wav).
UMAY_TTS_REFERENCE=
# Convert the spoken voice with an RVC voice pack from the Wichelberg voice changer (a folder, or a
# name in voice\rvc or Wichelberg's library). umay = her own pack in voice\rvc\umay. Empty = off.
UMAY_VOICE_PACK=umay
# Where the voice pack runs: cpu, or gpu (DirectML, only if its output matches the CPU's; up to
# ~2 GB of VRAM). Empty = the CPU with UMAY_LLM=local (the local model and Whisper take ~5 GB of
# an 8 GB card), else the GPU. Nothing runs during a game.
UMAY_RVC_DEVICE=
# Language of the text box, the Ctrl+F1 panel, the yes/no box: en (default) or tr.
UMAY_LANGUAGE=
# "Hey Umay" (or "Umay, wake up") starts a spoken conversation and "Umay, goodbye" ends it (wake.py,
# voice_session.py). Only on mains power with no game running (voice_guard "ready"); on battery or in a
# game the microphone is closed. off = never.
UMAY_WAKE=
# Unload the voice pack after this many idle minutes (default 3; it reloads in ~2 s on ðŸŽ¤).
UMAY_RVC_IDLE_MINUTES=
# Wichelberg's _wichelberg folder (default: Documents\Apps\Wichelberg\_wichelberg).
UMAY_WICHELBERG_DIR=
